# Base URL of the deliahapi/rescova backend that powers the "Anrufen lassen"
# widget (CtaSection.astro). Must be reachable over HTTPS from the browser
# and have this site's origin allow-listed there (ALLOWED_ORIGINS).
# Exposed to client-side code — PUBLIC_ prefix required by Astro/Vite.
PUBLIC_API_BASE_URL=https://api.rescova.de
