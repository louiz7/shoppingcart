---
const features = [
  {
    title: 'Fotografisches Gedächtnis',
    text: 'Evi merkt sich jeden Fall, jede Vereinbarung, jedes frühere Gespräch. Ihre Kunden müssen nichts zweimal erklären.',
    image: '/assets/Fotografisches Gedächtnis.png',
  },
  {
    title: 'Versteht jeden Anrufer',
    text: 'Natürliche Sprache in Echtzeit, jeder deutsche Dialekt, bei Bedarf mehrsprachig. Ihre Kunden führen ein Gespräch, keine Ansage.',
    image: '/assets/Trifft den richtigen Ton.png',
  },
  {
    title: 'Trifft den richtigen Ton',
    text: 'Evi reagiert auf den Gesprächsverlauf und passt die Ansprache einfühlsam und abgestimmt zur professionellen Klärung des Sachverhalts an.',
    image: '/assets/Versteht jeden Anrufer.png',
  },
];
---

<section class="features" id="technologie">
  <div class="container features__inner">
    <div class="features__header" data-reveal>
      <span class="badge">Qualifikationen</span>
      <h2 class="section-heading features__heading">
        Evi ruft an, klärt und <br />verhandelt rund um die Uhr
      </h2>
      <p class="features__sub">
        Stellen Sie sich eine Assistenz vor, die jeden Fall im Kopf hat, jeden
        Anrufer versteht und im richtigen Moment den richtigen Ton trifft.
      </p>
    </div>
    <div class="features__content">
      <div class="features__list" data-reveal>
        {
          features.map((feature, index) => (
            <div class="features__item" data-accordion-item data-open={index === 0 ? '' : undefined}>
              <h3>
                <button
                  type="button"
                  class="features__trigger"
                  id={`feature-trigger-${index}`}
                  aria-controls={`feature-panel-${index}`}
                  aria-expanded={index === 0 ? 'true' : 'false'}
                  data-preview-image={feature.image}
                  data-preview-alt={feature.title}
                >
                  {feature.title}
                </button>
              </h3>
              <div
                class="features__panel"
                id={`feature-panel-${index}`}
                role="region"
                aria-labelledby={`feature-trigger-${index}`}
              >
                <div class="features__panel-inner">
                  <p>{feature.text}</p>
                </div>
              </div>
              <div class="features__track">
                <div class="features__progress" data-progress></div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="features__card" data-reveal style="--reveal-delay: 0.15s">
        <img
          class="features__image"
          data-feature-preview
          src={features[0].image}
          alt={features[0].title}
          width="471"
          height="335"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding-top: 240px;
  }

  .features__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .features__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .features__heading {
    max-width: 550px;
    text-align: center;
  }

  .features__sub {
    max-width: 540px;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-muted);
  }

  .features__content {
    display: flex;
    align-items: center;
    gap: 32px;
    width: 100%;
  }

  .features__list {
    display: flex;
    flex-direction: column;
    gap: 21px;
    flex: 0 0 448px;
  }

  .features__item h3 {
    margin: 0;
  }

  .features__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.3;
    text-align: left;
    color: var(--color-black);
    cursor: pointer;
  }

  .features__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .features__item[data-open] .features__panel {
    grid-template-rows: 1fr;
  }

  .features__panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .features__panel-inner p {
    padding-top: 16px;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .features__track {
    height: 1px;
    width: 100%;
    margin-top: 21px;
    border-radius: 1px;
    background: var(--color-border);
    overflow: hidden;
  }

  .features__progress {
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: var(--color-black);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* The timer only runs once the list has scrolled into view (data-started). */
  .features__list[data-started] .features__item[data-open] .features__progress {
    animation: features-progress 8s linear forwards;
  }

  @keyframes features-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .features__list[data-started] .features__item[data-open] .features__progress {
      animation: none;
      transform: scaleX(1);
    }
  }

  .features__card {
    display: flex;
    flex: 0 0 720px;
    width: 720px;
    height: 398px;
    padding: 32px 125px 31px 124px;
    align-items: center;
    justify-content: center;
    border-radius: 30px;
    background: #ddd;
  }

  .features__image {
    width: 471px;
    height: 335px;
    aspect-ratio: 142 / 101;
    object-fit: contain;
  }

  @media (min-width: 1200px) {
    .features__content {
      width: calc(100% + 48px);
      max-width: 1200px;
    }
  }

  @media (max-width: 1199px) {
    .features__content {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .features__list {
      flex: none;
    }

    .features__card {
      /* In the column layout the base flex-basis (720px) would become the
         card's height, so reset it and let the aspect ratio size the card. */
      flex: none;
      width: 100%;
      height: auto;
      aspect-ratio: 720 / 398;
      padding: 32px 48px;
    }

    .features__image {
      width: 100%;
      height: 100%;
    }
  }

  @media (max-width: 599px) {
    .features {
      padding-top: 100px;
    }

    .features__card {
      aspect-ratio: auto;
      padding: 24px;
      border-radius: 20px;
    }

    .features__image {
      height: auto;
    }
  }
</style>

<script>
  document.querySelectorAll('.features__list').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLElement>('[data-accordion-item]')];
    const preview = list.parentElement?.querySelector<HTMLImageElement>('[data-feature-preview]');

    const openItem = (item: HTMLElement) => {
      items.forEach((other) => {
        other.removeAttribute('data-open');
        other.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
      item.setAttribute('data-open', '');
      const trigger = item.querySelector<HTMLButtonElement>('button');
      trigger?.setAttribute('aria-expanded', 'true');

      if (preview && trigger?.dataset.previewImage) {
        preview.src = trigger.dataset.previewImage;
        preview.alt = trigger.dataset.previewAlt ?? '';
      }
    };

    items.forEach((item, index) => {
      item.querySelector('button')?.addEventListener('click', () => {
        if (!item.hasAttribute('data-open')) {
          openItem(item);
        }
      });

      // The progress bar's animation finishing is the timer: advance to the next item.
      item.querySelector('[data-progress]')?.addEventListener('animationend', () => {
        openItem(items[(index + 1) % items.length]!);
      });
    });

    // Start the cycle from the first item once the accordion scrolls into view.
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          openItem(items[0]!);
          list.setAttribute('data-started', '');
          observer.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    observer.observe(list);
  });
</script>
