---

<header class="navbar">
  <a class="navbar__logo" href="#top" aria-label="Rescova — zum Seitenanfang">
    <img src="/assets/wordmark.svg" alt="Rescova" width="90" height="14" />
  </a>
  <nav class="navbar__links" aria-label="Hauptnavigation">
    <a href="#funktionsweise">Arbeitsweise</a>
    <a href="#technologie">Qualifikationen</a>
    <a href="#datenschutz">Datenschutz</a>
    <a href="#demo">Anrufen lassen</a>
  </nav>
  <button type="button" class="navbar__cta" data-pilot-open>
    <span class="navbar__cta-top">Pilot besprechen</span>
  </button>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('.navbar');

  if (navbar) {
    const updateNavbarState = () => {
      navbar.classList.toggle('navbar--scrolled', window.scrollY > window.innerHeight * 0.05);
    };

    window.addEventListener('scroll', updateNavbarState, { passive: true });
    updateNavbarState();

    navbar.querySelectorAll<HTMLAnchorElement>('.navbar__links a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const target = document.getElementById(link.hash.slice(1));
        if (!target) return;

        event.preventDefault();

        // Center the section in the viewport. We compute the offset manually
        // instead of using scrollIntoView({ block: 'center' }) because the
        // global `scroll-padding-top` skews that alignment away from center.
        // We center the content box (excluding the section's vertical padding),
        // since several sections use a large asymmetric `padding-top` as spacing
        // that would otherwise push their content below the true center.
        const rect = target.getBoundingClientRect();
        const style = getComputedStyle(target);
        const padTop = parseFloat(style.paddingTop) || 0;
        const padBottom = parseFloat(style.paddingBottom) || 0;
        const contentTop = rect.top + padTop;
        const contentHeight = rect.height - padTop - padBottom;
        const top =
          window.scrollY + contentTop + contentHeight / 2 - window.innerHeight / 2;
        window.scrollTo({
          top: Math.max(0, top),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      });
    });
  }
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 55px;
    padding: 8px 64px;
    background: var(--color-page-bg);
    transition:
      background-color 0.2s ease,
      -webkit-backdrop-filter 0.2s ease,
      backdrop-filter 0.2s ease;
  }

  .navbar--scrolled {
    background: rgba(255, 255, 255, 0.62);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
  }

  .navbar__logo {
    display: block;
    flex-shrink: 0;
  }

  .navbar__logo img {
    width: auto;
    height: 14px;
  }

  .navbar__links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-start;
    gap: 36px;
    text-align: center;
  }

  .navbar__links a {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    color: #4a4a4a;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .navbar__links a:hover {
    color: #000;
  }

  /* 3D push button: raised top layer over a darker base that peeks out 4px below */
  .navbar__cta {
    position: relative;
    display: block;
    flex-shrink: 0;
    padding: 0 0 4px;
    border: none;
    background: none;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .navbar__cta::before {
    content: '';
    position: absolute;
    inset: 4px 0 0;
    border-radius: 12px;
    background: #dd3d00;
  }

  .navbar__cta-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 35px;
    padding: 0 16px;
    border-radius: 10px;
    background: var(--color-button-primary);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-white);
    white-space: nowrap;
    /* springy overshoot easing so the release bounces back past the base */
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .navbar__cta:active .navbar__cta-top {
    transform: translateY(4px);
    transition: transform 0.08s ease-out;
  }

  @media (max-width: 960px) {
    .navbar__links {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .navbar {
      padding: 8px 24px;
    }
  }
</style>
