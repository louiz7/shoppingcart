---

---

<section class="why" id="warum-rescova">
  <div class="container why__inner">
    <div class="why__header" data-reveal>
      <span class="badge">Warum Rescova</span>
      <h2 class="section-heading">
        Effektiver als ihr Mahnlauf. <br /><em>Günstiger als Inkasso.</em>
      </h2>
      <p class="why__sub">
        Rescova sitzt genau dazwischen: die Klärung, die Ihr Mahnlauf
        strukturell nicht leisten kann, ohne den Preis und den Beziehungsverlust
        eines Inkassofalls.
      </p>
    </div>
    <img
      class="why__image"
      data-reveal
      style="--reveal-delay: 0.1s"
      src="/assets/placeholder.png"
      alt=""
      width="1200"
      height="400"
    />
  </div>
</section>

<style>
  .why {
    padding-top: 160px;
  }

  .why__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .why__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .why__sub {
    max-width: 600px;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .why__image {
    width: 100%;
    height: 400px;
    border-radius: 30px;
    object-fit: cover;
  }

  @media (max-width: 599px) {
    .why {
      padding-top: 100px;
    }

    .why__image {
      height: 260px;
    }
  }
</style>
