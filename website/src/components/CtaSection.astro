---

---

<section class="cta" id="demo">
  <div class="cta__card" data-reveal>
    <div class="cta__image" aria-hidden="true">
      <img src="/assets/cta-telefon.png" alt="" width="197" height="200" />
    </div>
    <div class="cta__content">
      <div class="cta__header">
        <h2 class="section-heading cta__heading">
          Evi live erleben
        </h2>
        <p class="cta__sub">
          Erleben Sie, wie Evi einen offenen Fall im Gespräch mit Ihnen klärt.
        </p>
      </div>
      <form class="cta__form" id="cta-form">
        <div class="cta__controls">
          <div class="cta__phone-field">
            <input
              class="cta__prefix"
              type="tel"
              name="country-code"
              value="+49"
              inputmode="tel"
              aria-label="Ländervorwahl"
              data-numeric="prefix"
              disabled
            />
            <input
              class="cta__input"
              type="tel"
              name="phone"
              placeholder="123456789"
              inputmode="numeric"
              autocomplete="tel-national"
              aria-label="Telefonnummer"
              data-numeric="digits"
              disabled
            />
          </div>
          <button type="submit" class="btn btn--ink" id="cta-submit" disabled aria-disabled="true">
            <span class="btn__top">
              <img src="/assets/call-white.svg" alt="" width="18" height="18" />
              Derzeit nicht verfügbar
            </span>
          </button>
        </div>
        <p class="cta__note cta__note--paused" id="cta-status" role="status" aria-live="polite">
          Die Telefon-Demo ist vorübergehend pausiert. Bitte versuchen Sie es später erneut.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || '';
  const E164 = /^\+[1-9]\d{6,14}$/;

  const form = document.getElementById('cta-form') as HTMLFormElement;
  const prefix = form.querySelector<HTMLInputElement>('.cta__prefix')!;
  const digits = form.querySelector<HTMLInputElement>('.cta__input')!;
  const submitBtn = document.getElementById('cta-submit') as HTMLButtonElement;
  const status = document.getElementById('cta-status')!;
  const defaultStatus = status.textContent || '';

  document.querySelectorAll<HTMLInputElement>('[data-numeric]').forEach((input) => {
    input.addEventListener('input', () => {
      if (input.dataset.numeric === 'prefix') {
        // Keep an optional leading "+", strip everything non-numeric after it.
        const numeric = input.value.replace(/\D/g, '');
        input.value = numeric ? `+${numeric}` : '';
      } else {
        input.value = input.value.replace(/\D/g, '');
      }
    });
  });

  function setStatus(text: string, variant: '' | 'err' | 'ok' = '') {
    status.textContent = text;
    status.className = 'cta__note' + (variant ? ` cta__note--${variant}` : '');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const targetNumber = `${prefix.value}${digits.value}`.replace(/[\s()-]/g, '');
    if (!E164.test(targetNumber)) {
      setStatus('Bitte eine gültige Telefonnummer eingeben.', 'err');
      return;
    }

    submitBtn.disabled = true;
    setStatus('Evi ruft an …');

    try {
      const res = await fetch(`${API_BASE_URL}/v1/outbound-call`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ targetNumber }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || data.error || `HTTP ${res.status}`);
      setStatus('Anruf gestartet — Evi ruft Sie gleich an!', 'ok');
    } catch (err) {
      setStatus(`Fehler: ${(err as Error).message}`, 'err');
    } finally {
      submitBtn.disabled = false;
      setTimeout(() => setStatus(defaultStatus), 8000);
    }
  });
</script>

<style>
  /* Keep generous separation from the preceding content. */
  .cta {
    position: relative;
    z-index: 2;
    padding-top: 240px;
    padding-bottom: 240px;
    padding-inline: 24px;
  }

  .cta__card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    width: 100%;
    max-width: 1200px;
    height: 400px;
    margin-inline: auto;
    padding: 80px 160px;
    border: 1px solid #e1e1e1;
    border-radius: 30px;
    background: var(--color-white);
    box-shadow: 0 8px 0 #e1e1e1;
  }

  .cta__image {
    flex-shrink: 0;
    width: 197px;
    height: 200px;
  }

  .cta__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
  }

  .cta__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .cta__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .cta__sub {
    max-width: 400px;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.8);
  }

  .cta__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .cta__controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cta__phone-field {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 250px;
    height: 42px;
    padding: 0 16px;
    border: 1px solid #d7dee6;
    border-radius: 12px;
    background: var(--color-white);
  }

  .cta__prefix {
    flex-shrink: 0;
    width: 34px;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-black);
  }

  .cta__input {
    min-width: 0;
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-black);
  }

  .cta__input::placeholder {
    color: #9a9a9a;
  }

  .cta__phone-field:focus-within {
    border-color: var(--color-button-primary);
    box-shadow: 0 0 0 4px rgba(255, 76, 0, 0.18);
  }

  .cta__phone-field:has(input:disabled) {
    background: #f5f5f5;
    opacity: 0.62;
  }

  .cta__phone-field input:disabled,
  #cta-submit:disabled {
    cursor: not-allowed;
  }

  #cta-submit:disabled {
    opacity: 0.58;
  }

  .cta__note {
    max-width: 400px;
    font-weight: 500;
    font-style: italic;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
    color: rgba(0, 0, 0, 0.3);
  }

  .cta__note--ok {
    color: #1a7a4c;
  }

  .cta__note--err {
    color: #c23a3a;
  }

  .cta__note--paused {
    color: rgba(0, 0, 0, 0.55);
  }

  .cta__note a {
    color: inherit;
    text-underline-offset: 2px;
  }

  .cta__note a:hover {
    color: var(--color-button-primary);
  }

  @media (max-width: 1099px) {
    .cta__card {
      height: auto;
      padding: 64px 48px;
    }
  }

  @media (max-width: 767px) {
    .cta__card {
      flex-direction: column;
      gap: 32px;
      text-align: center;
    }

    .cta__content,
    .cta__header {
      align-items: center;
    }

    .cta__content {
      gap: 32px;
    }

    .cta__form {
      width: 100%;
    }
  }

  @media (max-width: 599px) {
    .cta {
      padding-top: 100px;
      padding-bottom: 100px;
    }

    .cta__card {
      padding: 48px 24px;
      border-radius: 20px;
    }

    .cta__image {
      width: 148px;
      height: 150px;
    }

    .cta__sub {
      font-size: 16px;
    }

    .cta__controls {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 340px;
    }

    .cta__phone-field {
      width: 100%;
    }
  }
</style>
