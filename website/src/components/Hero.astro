---

---

<section class="hero">
  <div class="hero__pin">
    <div class="hero__card">
      <span class="hero__pill" data-reveal>Für Inkasso- und Forderungsmanagement</span>
      <h1 class="hero__heading" data-reveal>
        Offene Forderungen klären <br /><em>mit KI, die zuhört und handelt</em>
      </h1>
      <p class="hero__sub" data-reveal style="--reveal-delay: 0.1s">
        Evi kontaktiert säumige Kund:innen über Telefon, SMS und E-Mail,
        versteht den Grund der Nichtzahlung und arbeitet innerhalb Ihrer Regeln
        auf eine Lösung hin.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay: 0.2s">
        <button type="button" class="btn btn--dark" data-pilot-open>
          <span class="btn__top">Jetzt Pilot besprechen</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Drives --hero-p (0 = fullscreen image, 1 = card). The runway is derived
  // from the rendered layout (hero height minus the final card bottom edge)
  // so the pin releases exactly when the morph completes.
  const hero = document.querySelector<HTMLElement>('.hero');
  const card = document.querySelector<HTMLElement>('.hero__card');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && card && !reduceMotion.matches) {
    let runway = 1;
    let ticking = false;

    const measure = () => {
      const styles = getComputedStyle(card);
      const cardBottom =
        parseFloat(styles.getPropertyValue('--card-top')) +
        parseFloat(styles.getPropertyValue('--card-height'));
      runway = Math.max(1, hero.offsetHeight - cardBottom);
    };

    const update = () => {
      ticking = false;
      const p = Math.min(1, Math.max(0, window.scrollY / runway));
      hero.style.setProperty('--hero-p', String(p));
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        measure();
        onScroll();
      },
      { passive: true }
    );
    measure();
    update();
  }
</script>

<style>
  /* Without JS (or with reduced motion) --hero-p stays at 1, which is the
     plain card design; the script animates it from 0 while the pinned hero
     eats the runway. */
  .hero {
    --hero-p: 1;
    --card-width: min(1200px, 100% - 48px);
    --card-height: 715px;
    --card-radius: 30px;
    --card-top: 120px;
  }

  /* The pin shrinks from 100svh down to the card's bottom edge while the
     runway is scrolled, so the section below approaches at scroll speed and
     docks flush against the card the moment the morph completes — no dead
     gap, no jump at release. The runway grows on tall viewports so the next
     section never peeks in while the image is still fullscreen. */
  html.js .hero {
    --hero-final: calc(var(--card-top) + var(--card-height));
    --hero-runway: max(300px, 100svh - var(--hero-final));
    height: calc(var(--hero-final) + var(--hero-runway));
  }

  /* Flex column so the card's animated margin-top doesn't collapse through
     the pin and get lost. */
  .hero__pin {
    display: flex;
    flex-direction: column;
  }

  html.js .hero__pin {
    position: sticky;
    top: 0;
    height: calc(100svh + (var(--hero-final) - 100svh) * var(--hero-p));
  }

  .hero__card {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    width: calc(100% + (var(--card-width) - 100%) * var(--hero-p));
    height: calc(100svh + (var(--card-height) - 100svh) * var(--hero-p));
    margin-inline: auto;
    margin-top: calc(var(--card-top) * var(--hero-p));
    padding: 64px 32px;
    border-radius: calc(var(--card-radius) * var(--hero-p));
    background: url('/assets/hero_glasslands_dither.png') center / cover no-repeat #e8f1f8;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .hero {
      height: auto;
    }

    html.js .hero__pin {
      position: static;
      height: auto;
    }
  }

  .hero__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 48px;
    line-height: 1.2;
    text-align: center;
  }

  .hero__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 16px;
    border: 0.5px solid #ff4c00;
    border-radius: 20px;
    background: #fff;
    color: #ff4c00;
    font-family: 'Helvetica Neue';
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 130%;
  }

  .hero__heading em {
    font-style: italic;
    color: var(--color-button-primary);
  }

  .hero__sub {
    max-width: 600px;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    gap: 16px;
  }

  /* On mobile the scroll morph is disabled: the hero is a plain fullscreen
     image section, no pin, no card frame. The JS keeps writing --hero-p but
     these overrides make it inert. */
  @media (max-width: 767px) {
    html.js .hero {
      height: auto;
    }

    html.js .hero__pin {
      position: static;
      height: auto;
    }

    .hero__card {
      width: 100%;
      height: 100svh;
      margin-top: 0;
      border-radius: 0;
      padding: 48px 24px;
    }

    .hero__heading {
      font-size: 36px;
    }

    .hero__heading br {
      display: none;
    }

    .hero__sub {
      font-size: 18px;
    }
  }
</style>
