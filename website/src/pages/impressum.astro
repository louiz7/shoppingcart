---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Impressum | Rescova"
  description="Impressum und Anbieterkennzeichnung der Inflection Studio UG (haftungsbeschränkt)"
>
  <header class="legal-header">
    <a class="legal-header__logo" href="/" aria-label="Rescova — zur Startseite">
      <img src="/assets/wordmark.svg" alt="Rescova" width="90" height="14" />
    </a>
    <a class="legal-header__back" href="/">Zur Startseite</a>
  </header>

  <main class="legal-page">
    <article class="legal-content">
      <p class="legal-content__eyebrow">Rechtliches</p>
      <h1>Impressum</h1>

      <section>
        <h2>Angaben gemäß § 5 DDG</h2>
        <address>
          Inflection Studio UG (haftungsbeschränkt)<br />
          Donaustraße 44<br />
          12043 Berlin<br />
          Deutschland
        </address>
      </section>

      <section>
        <h2>Vertreten durch</h2>
        <p>
          Geschäftsführer: Nils Heck<br />
          Prokuristen: Robert Jonathan Jacobs, Louiz El-Hosri und Milan Maus
        </p>
      </section>

      <section>
        <h2>Registereintrag</h2>
        <p>
          Registergericht: Amtsgericht Stuttgart<br />
          Registernummer: HRB 805955
        </p>
      </section>

      <section>
        <h2>Kontakt</h2>
        <p>
          Telefon: <a href="tel:+4915679547981">+49 156 79547981</a><br />
          E-Mail: <a href="mailto:robert@rescova.de">robert@rescova.de</a>
        </p>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .legal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 55px;
    padding: 8px 64px;
    border-bottom: 1px solid #e1e1e1;
    background: var(--color-page-bg);
  }

  .legal-header__logo {
    display: block;
  }

  .legal-header__logo img {
    width: auto;
    height: 14px;
  }

  .legal-header__back {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-black);
    text-decoration: none;
  }

  .legal-header__back:hover,
  .legal-content a:hover {
    color: var(--color-button-primary);
  }

  .legal-page {
    min-height: calc(100vh - 55px);
    padding: 112px 32px 160px;
  }

  .legal-content {
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }

  .legal-content__eyebrow {
    margin-bottom: 16px;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-button-primary);
  }

  .legal-content h1 {
    margin: 0 0 56px;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .legal-content section + section {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .legal-content h2 {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.3;
  }

  .legal-content p,
  .legal-content address {
    margin: 0;
    font-weight: 500;
    font-style: normal;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .legal-content a {
    color: inherit;
    text-underline-offset: 3px;
  }

  @media (max-width: 767px) {
    .legal-header {
      padding-inline: 24px;
    }

    .legal-page {
      padding: 64px 24px 100px;
    }

    .legal-content h1 {
      margin-bottom: 40px;
    }

    .legal-content section + section {
      margin-top: 32px;
      padding-top: 32px;
    }
  }
</style>
