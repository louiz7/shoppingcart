# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL on Njalla VPS)
DATABASE_URL=postgres://deliah:password@localhost:5432/deliahapi
CAMPAIGN_SCHEDULER_ENABLED=1
CAMPAIGN_SCHEDULER_POLL_MS=5000
CAMPAIGN_RETRY_INTERVAL_MINUTES=60
CALL_RECONCILE_INTERVAL_MS=30000
CALL_RECONCILE_GRACE_MS=60000

# Tenant email connectors. The same 32-byte encryption key must be configured
# for the API worker and dashboard. Generate once with: openssl rand -hex 32
EMAIL_WORKER_ENABLED=1
EMAIL_POLL_INTERVAL_MS=60000
EMAIL_CREDENTIALS_KEY=replace_with_64_hex_characters

# Microsoft Entra multi-tenant app (delegated Graph access). Register the exact
# redirect URI as a Web redirect in Entra. Do not use a wildcard URI.
MICROSOFT_CLIENT_ID=replace_with_entra_application_client_id
MICROSOFT_CLIENT_SECRET=replace_with_entra_client_secret
MICROSOFT_REDIRECT_URI=https://app.rescova.de/admin/email/microsoft/callback

# Dropsize-only Shopify Admin API integration. Create the app in Shopify's Dev
# Dashboard with read_customers/read_orders and the exact redirect URI below.
# SHOPIFY_CREDENTIALS_KEY can be omitted to reuse EMAIL_CREDENTIALS_KEY while
# still using a distinct authenticated-encryption context.
SHOPIFY_CLIENT_ID=replace_with_shopify_client_id
SHOPIFY_CLIENT_SECRET=replace_with_shopify_client_secret
SHOPIFY_REDIRECT_URI=https://app.rescova.de/admin/integrations/shopify/callback
# SHOPIFY_CREDENTIALS_KEY=replace_with_64_hex_characters

# Lightweight LLM used only to create Dropsize email drafts. Responses are not
# stored by OpenAI through the API request, and Rescova retains approval-before-send.
OPENAI_API_KEY=replace_with_openai_project_api_key
OPENAI_EMAIL_MODEL=gpt-5-mini

# Pricing (USD per minute of voice usage, billed to customer)
PRICE_PER_MINUTE=0.15

# LiveKit rooms and signed webhooks. The Evi worker bridges SIP call rooms to
# Deepslate Opal server-side. Get these from the LiveKit Cloud dashboard (or
# self-host).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_TOKEN_TTL=900

# LiveKit connects directly to Twilio Elastic SIP Trunking in Frankfurt using
# TLS + SRTP. SIP_AUTH_* must match a Twilio Credential List attached to the
# trunk. Never expose these credentials to the browser or commit real values.
LIVEKIT_SIP_TRUNK_ID=replace_with_sip_trunk_id
# Leave blank on the first run so setup creates a parallel trunk. Afterwards,
# set this to the newly-created Twilio LiveKit trunk ID for setup updates only.
SIP_TRUNK_SETUP_ID=
SIP_TRUNK_NAME=twilio-frankfurt
SIP_TRUNK_ADDRESS=rescova-neu.pstn.frankfurt.twilio.com
SIP_TRANSPORT=TLS
SIP_MEDIA_ENCRYPTION=REQUIRE
SIP_DESTINATION_COUNTRY=DE
SIP_AUTH_USERNAME=replace_with_twilio_credential_username
SIP_AUTH_PASSWORD=replace_with_twilio_credential_password
# Leave blank until a Twilio-owned or Twilio-verified E.164 caller ID is ready.
# Outbound calling intentionally remains disabled while this is blank.
SIP_CALLER_ID=

# CORS allow-list for POST /v1/outbound-call (the public "call me" widget on
# rescova-website). Comma-separated origins, no trailing slash.
ALLOWED_ORIGINS=https://rescova.de,https://www.rescova.de

# Rate limiting for POST /v1/outbound-call (defaults shown).
OUTBOUND_CALL_IP_WINDOW_MS=3600000
OUTBOUND_CALL_IP_MAX=5
OUTBOUND_CALL_NUMBER_COOLDOWN_MS=600000

# Customer under which /v1/outbound-call auto-provisions ephemeral demo
# cases/debtors (see scripts/seed-demo-policy.js).
DEMO_CUSTOMER_ID=1
# Fictional invoice amount (cents) used for each /v1/outbound-call demo case.
OUTBOUND_CALL_DEMO_AMOUNT_CENTS=41019

# Shared secret for the internal Tool Gateway (/internal/tools/*) used by the
# Python agent worker on the same box. Generate: openssl rand -hex 32.
# The gateway refuses everything if this is unset (fail closed).
INTERNAL_TOOL_SECRET=replace_with_random_hex

# Lifetime of the per-call case token minted at dial time (minutes).
CALL_TOKEN_TTL_MIN=60

# Telegram lead notifications for POST /v1/pilot-lead (the marketing-site
# "Pilot besprechen" form). Create a bot via @BotFather to get the token, add
# the bot to your channel/group as an admin, and set the target chat. For a
# chat, TELEGRAM_CHAT_ID is: @channelusername for a public channel, a plain
# negative id (e.g. -5176371498) for a basic group, or a -100... id for a
# supergroup/private channel. Verify with getChat before relying on it.
# Put the real values in .env (gitignored), never here.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id

# Rate limiting for POST /v1/pilot-lead (defaults shown).
PILOT_LEAD_IP_WINDOW_MS=3600000
PILOT_LEAD_IP_MAX=10

# Cart Recovery pilot. Separate from collection campaigns; off unless explicitly enabled.
RECOVERY_WORKER_ENABLED=0
RECOVERY_LIVE_ENABLED=0
RECOVERY_SMS_ENABLED=0
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_SMS_FROM=
GPT_LIVE_DEMO_ENABLED=0
LIVEKIT_AGENT_NAME=shoppingcart-local
RECOVERY_SHOPIFY_WEBHOOK_RELAY_ENABLED=0
RECOVERY_TWILIO_WEBHOOK_RELAY_ENABLED=0
RECOVERY_LIVEKIT_WEBHOOK_RELAY_ENABLED=0
RECOVERY_SIP_TRUNK_ID=
RECOVERY_CALLER_ID=
OPENAI_RECOVERY_BACKEND_MODEL=gpt-5.6-luna
# Recovery defaults to this regional endpoint; match the API key's project residency.
OPENAI_BASE_URL=https://eu.api.openai.com/v1
RECOVERY_API_URL=http://127.0.0.1:3110
RECOVERY_DASHBOARD_URL=http://localhost:5173
# Public HTTPS API origin for per-shop Shopify webhooks and Twilio delivery callbacks.
RECOVERY_PUBLIC_URL=
# Optional: otherwise the existing SHOPIFY_REDIRECT_URI is reused.
# Optional second app, restricted to this exact merchant .myshopify.com domain.
RECOVERY_SHOPIFY_CUSTOM_DOMAIN=
SHOPIFY_CUSTOM_CLIENT_ID=
SHOPIFY_CUSTOM_CLIENT_SECRET=
RECOVERY_SHOPIFY_REDIRECT_URI=
RECOVERY_TEST_SHOP_DOMAIN=
# Restrict the dedicated Ecom dashboard to organization/auth/recovery routes.
RECOVERY_ONLY=0
