[Unit]
Description=Rescova API backend
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/deliahapi
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deliahapi

# Load .env
EnvironmentFile=/opt/deliahapi/.env

[Install]
WantedBy=multi-user.target
