# LiveKit connection (same project as the backend's LIVEKIT_* vars).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Deepslate (server-side master credentials — never sent to the browser).
DEEPSLATE_VENDOR_ID=8faa1d12-1338-46b9-8ad3-a3f78ded55cc
DEEPSLATE_ORGANIZATION_ID=1319ef5d-493d-4755-9fcc-a7141a883a1f
DEEPSLATE_API_KEY=replace_with_master_bearer_token

# Evi's persona and hosted voice are supplied through trusted room metadata by
# src/services/case-call-service.js; there is no environment-level fallback.

# Tool Gateway (Node backend on the same box) for case-mode calls. The secret
# must match the backend's INTERNAL_TOOL_SECRET.
TOOL_GATEWAY_URL=http://127.0.0.1:3000
INTERNAL_TOOL_SECRET=replace_with_random_hex

# Telephone audio tuning. Short replies such as "ja" must cross VAD quickly;
# callcenter ambience is opt-in because it can mask speech on narrowband PSTN.
VAD_CONFIDENCE_THRESHOLD=0.3
VAD_MIN_VOLUME=0.001
VAD_START_DURATION_MS=80
VAD_STOP_DURATION_MS=350
BARGE_IN_MIN_MS=600
# 1 enables caller interruption while Evi speaks. Set to 0 and restart the
# agent to restore the previous half-duplex echo guard immediately.
FULL_DUPLEX_BARGE_IN_ENABLED=1
BACKGROUND_AUDIO_ENABLED=0
BACKGROUND_AMBIENT_VOLUME=0.15
